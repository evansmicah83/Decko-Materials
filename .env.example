# Decko Africa Field Materials Management System Environment Configuration
PORT=3000
NODE_ENV=development
DATABASE_URL=file:./data/decko_materials.db
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret-at-least-32-characters
API_BASE_URL=/api/v1
COMPANY_NAME="Decko Africa Ltd."
COMPANY_WEBSITE="https://deckoafrica.com"
STORAGE_PROVIDER=local
SLA_APPROVAL_HOURS=4
SLA_PAYMENT_HOURS=8
SLA_ISSUE_HOURS=4
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
